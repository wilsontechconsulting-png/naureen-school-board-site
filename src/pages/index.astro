---
import globalCss from '../styles/global.css?raw';

const priorities = [
  {
    title: 'Student Achievement',
    text: 'Keep board decisions focused on measurable learning, strong fundamentals, and the support every student needs to move forward.',
  },
  {
    title: 'Family Partnership',
    text: 'Families deserve clear communication, respectful listening, and a board that treats parents as partners in student success.',
  },
  {
    title: 'Educator Support',
    text: 'Strong schools require teachers and staff who are respected, supported, and equipped to serve students well.',
  },
  {
    title: 'Responsible Stewardship',
    text: 'Budgets should be transparent, practical, and tied to the classroom outcomes Columbia, IL families expect.',
  },
];

const beliefs = [
  {
    title: 'Prepared Decisions',
    text: 'School board decisions should be made with homework done, questions asked, and the long-term needs of Columbia students in mind.',
  },
  {
    title: 'Open Communication',
    text: 'Families and staff deserve clear explanations, respectful listening, and fewer surprises when decisions affect classrooms and students.',
  },
  {
    title: 'Eagle Pride',
    text: 'Columbia schools are part of the community identity. The campaign should reflect local pride while staying independent from the district.',
  },
];

const actionOptions = [
  'Request a yard sign',
  'Volunteer for voter outreach',
  'Host a meet-and-greet',
  'Receive campaign updates',
];

const boardRecord = [
  {
    title: 'Current Board Service',
    text: '[Add Naureen\'s current board role, committees, appointed/elected service dates, and any board responsibilities.]',
  },
  {
    title: 'Work Supported',
    text: '[Add 3-5 specific items she supported or helped move forward, such as student programs, safety, curriculum, facilities, finance, or communication.]',
  },
  {
    title: 'What She Has Learned',
    text: '[Add a plain-English reflection from Naureen about what serving has taught her about Columbia CUSD 4 families, students, staff, and taxpayers.]',
  },
];

const endorsements = [
  {
    quote: '[Add short endorsement quote from a Columbia parent, teacher, community member, or local leader.]',
    name: '[Name, relationship to Columbia schools]',
  },
  {
    quote: '[Add short endorsement quote focused on Naureen\'s preparation, listening, or service.]',
    name: '[Name, relationship to Columbia schools]',
  },
  {
    quote: '[Add short endorsement quote from someone who can speak to her character and community involvement.]',
    name: '[Name, relationship to Columbia schools]',
  },
];

const voterInfo = [
  { label: 'Election Day', value: 'April 6, 2027 consolidated election' },
  { label: 'District', value: 'Columbia Community Unit School District 4, Columbia, IL' },
  { label: 'Local Election Office', value: 'Monroe County Clerk, 618-939-8623 ext. 302' },
  { label: 'Vote by Mail', value: 'Monroe County offers regular and permanent vote-by-mail options.' },
];

const trustItems = [
  'This campaign is independent and is not sponsored by Columbia CUSD 4.',
  'Any official district logo, mascot, or school property should be used only with permission.',
  'Any campaign photo with students or children should be used only with parent/guardian permission.',
  '[Add official campaign committee name]',
  '[Add campaign treasurer name, if required]',
  '[Add required paid-for-by disclaimer]',
];

const votingLinks = [
  { label: 'Monroe County Elections', href: 'https://www.mococlerk.com/elections.html' },
  { label: 'Voter Lookup', href: 'https://www.mococlerk.com/elections.html' },
  { label: 'Illinois School Board Election Info', href: 'https://www.iasb.com/memberships-and-divisions/school-board-elections' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Naureen Stack-Frierdich is running for re-election to the Columbia Community Unit School District 4 Board of Education in Columbia, IL with a campaign focused on students, schools, and community."
    />
    <title>Re-elect Naureen Stack-Frierdich for Columbia School Board</title>
    <style set:html={globalCss}></style>
  </head>
  <body>
    <header class="site-header" aria-label="Campaign header">
      <a class="brand" href="#top" aria-label="Naureen campaign home">
        <img class="brand-mark" src={`${import.meta.env.BASE_URL}images/naureen-eagles-campaign-mark.svg`} alt="" />
        <span class="brand-name">Re-elect Naureen for Columbia School Board</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#heart">Heart</a>
        <a href="#gratitude">Gratitude</a>
        <a href="#priorities">Priorities</a>
        <a href="#record">Record</a>
        <a href="#support">Support</a>
        <a href="#vote">Vote</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-content">
          <div>
            <p class="eyebrow">Columbia, IL • CUSD 4 Board of Education</p>
            <h1 id="hero-title">Re-ELECT Naureen Stack-Frierdich</h1>
            <p class="hero-slogan">
              <span>Focused on the Future:</span>
              <span>For our students.</span>
              <span>For our schools.</span>
              <span>For our community.</span>
            </p>
          </div>
          <div class="hero-photo">
            <img
              src={`${import.meta.env.BASE_URL}images/naureen-with-kids.jpg`}
              alt="Naureen Stack-Frierdich with her children"
            />
          </div>
        </div>
      </section>

      <section class="intro-section" id="gratitude" aria-labelledby="gratitude-title">
        <div class="section-inner intro-grid">
          <div>
            <p class="section-kicker">Focused on What Matters Most</p>
            <h2 id="gratitude-title">Focused on Gratitude</h2>
          </div>
          <div class="prose gratitude-copy">
            <p>
              For the past four years, I have been truly honored and grateful for the opportunity to serve our students, our schools, and our community.
            </p>
            <p>
              This experience has been filled with meaningful conversations, important decisions, challenges, lessons, and countless reminders of how special our community is.
            </p>
            <p>
              I’m grateful for the trust you placed in me four years ago, and for everyone who has taken the time to share their ideas, concerns, encouragement, and perspective along the way.
            </p>
            <p>
              Serving on the school board has given me an even greater appreciation for the dedication of our teachers and staff, the support of our families, and the incredible potential of our students.
            </p>
            <p>
              It has been a privilege to listen, learn, and be part of the work that helps shape our schools and our community. I don’t take that responsibility lightly, and I’m incredibly thankful for these four years of service.
            </p>
            <p>
              As I look ahead, my gratitude for where we’ve been only strengthens my commitment to remain focused on the future: for our students, for our schools, and for our community.
            </p>
          </div>
        </div>
      </section>

      <section class="meet-section" id="heart" aria-labelledby="heart-title">
        <div class="section-inner candidate-grid">
          <div class="candidate-photo">
            <img
              src={`${import.meta.env.BASE_URL}images/naureen-heart-focus.jpg`}
              alt="Naureen Stack-Frierdich wearing a Columbia Eagles shirt"
            />
          </div>
          <div class="prose">
            <p class="section-kicker">The Heart Behind the Focus</p>
            <h2 id="heart-title">The Heart Behind the Focus</h2>
            <p>
              [This will be Naureen's why. Add her personal story, her connection to Columbia schools, and the reason she feels called to continue serving.]
            </p>
            <p class="local-note">
              Columbia CUSD 4 serves Columbia High School, Columbia Middle School, Eagleview Elementary School, and Parkview Elementary School. This site should speak to the full PreK-12 school community, not just one campus.
            </p>
          </div>
        </div>
      </section>

      <section class="priorities-section" id="priorities" aria-labelledby="priorities-title">
        <div class="section-inner">
          <div class="section-heading">
            <p class="section-kicker">Campaign priorities</p>
            <h2 id="priorities-title">A clean, educated campaign starts with substance.</h2>
          </div>
          <div class="priority-grid">
            {priorities.map((priority) => (
              <article class="priority-item">
                <h3>{priority.title}</h3>
                <p>{priority.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="beliefs-section" id="beliefs" aria-labelledby="beliefs-title">
        <div class="section-inner">
          <div class="section-heading">
            <p class="section-kicker">What I believe</p>
            <h2 id="beliefs-title">A calm, clear approach to serving Columbia schools.</h2>
          </div>
          <div class="belief-grid">
            {beliefs.map((belief) => (
              <article class="belief-item">
                <h3>{belief.title}</h3>
                <p>{belief.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="record-section" id="record" aria-labelledby="record-title">
        <div class="section-inner">
          <div class="section-heading">
            <p class="section-kicker">Board service</p>
            <h2 id="record-title">Board experience voters can understand.</h2>
          </div>
          <div class="record-list">
            {boardRecord.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="support-section" id="support" aria-labelledby="support-title">
        <div class="section-inner support-grid">
          <div>
            <p class="section-kicker">Community support</p>
            <h2 id="support-title">Local voices matter in a school board campaign.</h2>
            <p>
              Endorsements should be short, specific, and rooted in Columbia. The strongest quotes will come from people who can speak honestly about Naureen's preparation, listening, judgment, and service.
            </p>
          </div>
          <div class="endorsement-list">
            {endorsements.map((endorsement) => (
              <figure>
                <blockquote>{endorsement.quote}</blockquote>
                <figcaption>{endorsement.name}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="vote-section" id="vote" aria-labelledby="vote-title">
        <div class="section-inner vote-grid">
          <div>
            <p class="section-kicker">Election center</p>
            <h2 id="vote-title">Make a plan for the 2027 school board election.</h2>
            <p>
              Illinois school board elections are nonpartisan and are held during consolidated elections. Voters should confirm registration, polling location, early voting, and vote-by-mail details with the Monroe County Clerk before Election Day.
            </p>
            <div class="link-row">
              {votingLinks.map((link) => (
                <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
              ))}
            </div>
          </div>
          <div class="vote-details">
            {voterInfo.map((item) => (
              <div class="vote-row">
                <span>{item.label}</span>
                <strong>{item.value}</strong>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="involved-section" id="involved" aria-labelledby="involved-title">
        <div class="section-inner involved-grid">
          <div>
            <p class="section-kicker">Get involved</p>
            <h2 id="involved-title">Turn local support into practical campaign help.</h2>
            <p>
              A school board campaign needs neighbors who are willing to have respectful conversations, share accurate information, and help voters know when and where to participate.
            </p>
          </div>
          <form class="action-panel campaign-form" action="mailto:campaign@example.com" method="post" enctype="text/plain">
            <label>
              Name
              <input name="name" type="text" placeholder="[Your name]" />
            </label>
            <label>
              Email or phone
              <input name="contact" type="text" placeholder="[Best way to reach you]" />
            </label>
            <label>
              I can help with
              <select name="interest">
                {actionOptions.map((item) => <option>{item}</option>)}
              </select>
            </label>
            <label>
              Message
              <textarea name="message" rows="4" placeholder="[Optional note]"></textarea>
            </label>
            <p class="form-note">Replace campaign@example.com with the official campaign email before launch.</p>
            <button class="button primary full" type="submit">Send Campaign Note</button>
          </form>
        </div>
      </section>

      <section class="trust-section" id="trust" aria-labelledby="trust-title">
        <div class="section-inner trust-grid">
          <div>
            <p class="section-kicker">Trust and compliance</p>
            <h2 id="trust-title">Clear campaign information before launch.</h2>
          </div>
          <ul>
            {trustItems.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>Re-elect Naureen Stack-Frierdich for Columbia School Board</p>
      <p class="disclaimer">Campaign disclaimer to be added before public launch.</p>
    </footer>
  </body>
</html>
