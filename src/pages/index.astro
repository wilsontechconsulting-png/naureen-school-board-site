---
import globalCss from '../styles/global.css?raw';

const base = import.meta.env.BASE_URL;

const focusLetters = [
  {
    letter: 'F',
    title: 'Future Focused',
    text: "Preparing our students and schools for tomorrow's opportunities.",
  },
  {
    letter: 'O',
    title: 'Open Communication',
    text: 'Creating transparency, listening to families and educators, and keeping our community informed while maintaining confidentiality.',
  },
  {
    letter: 'C',
    title: 'Community',
    text: 'Working together with students, parents, teachers, staff, and community members.',
  },
  {
    letter: 'U',
    title: 'Understanding',
    text: 'Taking the time to listen, ask questions, and understand different perspectives before making decisions.',
  },
  {
    letter: 'S',
    title: 'Student Centered',
    text: 'Keeping the success, safety, growth, and well-being of our students at the heart of every decision.',
  },
];

const experienceItems = [
  {
    title: 'Listen',
    text: 'Good governance starts with listening to families, educators, staff, students, and community members who see the district from different angles.',
  },
  {
    title: 'Learn',
    text: 'Four years of service has deepened my understanding of both the opportunities and the challenges facing Columbia CUSD 4.',
  },
  {
    title: 'Lead',
    text: 'Leadership means doing the homework, asking good questions, and being willing to make difficult decisions when necessary.',
  },
];

const communityGallery = [
  {
    src: 'images/community-athlete-month.jpg',
    alt: 'Athletes of the Month graphic with Columbia students and local sponsors',
    caption: 'Celebrating our students through Athlete of the Month.',
  },
  {
    src: 'images/community-wear-blue.jpg',
    alt: 'Columbia students holding an On Fridays We Wear Blue school spirit sign',
    caption: 'Showing up for school spirit, athletics, and activities.',
  },
  {
    src: 'images/community-educator-support.jpg',
    alt: 'Columbia school supporters standing beside student eagle artwork',
    caption: 'Supporting educators, appreciation events, and school support.',
  },
];

const voices = [
  {
    quote: '[Add short endorsement from a parent, educator, community member, or person who has worked alongside Naureen.]',
    name: '[Name, relationship to Columbia schools]',
  },
  {
    quote: '[Add a specific quote about preparation, listening, service, or community involvement.]',
    name: '[Name, relationship to Columbia schools]',
  },
  {
    quote: '[Add a character-focused quote that feels credible and grounded, not promotional.]',
    name: '[Name, relationship to Columbia schools]',
  },
];

const voteLinks = [
  {
    label: 'Voter registration',
    href: 'https://ova.elections.il.gov/',
  },
  {
    label: 'Polling place lookup',
    href: 'https://ova.elections.il.gov/pollingplacelookup.aspx',
  },
  {
    label: 'Monroe County elections',
    href: 'https://www.mococlerk.com/elections.html',
  },
  {
    label: 'Illinois State Board of Elections',
    href: 'https://www.elections.il.gov/',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Re-elect Naureen Stack for Columbia CUSD 4 School Board. Focused on the future for our students, our schools, and our community."
    />
    <title>Re-elect Naureen Stack for Columbia CUSD 4 School Board</title>
    <style set:html={globalCss}></style>
  </head>
  <body>
    <header class="site-header" aria-label="Campaign header">
      <a class="brand" href="#top" aria-label="Naureen Stack campaign home">
        <span class="brand-name">Naureen Stack</span>
        <span class="brand-subtitle">Columbia CUSD 4 School Board</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#focus">FOCUS</a>
        <a href="#experience">EXPERIENCE</a>
        <a href="#community">COMMUNITY</a>
        <a href="#about">ABOUT</a>
        <a href="#vote">VOTE</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-content">
          <p class="eyebrow">Columbia Community Unit School District 4</p>
          <h1 id="hero-title">Re-Elect Naureen Stack</h1>
          <p class="hero-office">Columbia CUSD 4 School Board</p>
          <p class="hero-theme">Focused on the future for our students, for our schools, for our community.</p>
          <div class="hero-actions" aria-label="Primary campaign links">
            <a class="button primary" href="#why">Why I’m Running</a>
            <a class="button secondary" href="#focus">FOCUS</a>
          </div>
        </div>
        <figure class="hero-photo">
          <img src={`${base}images/naureen-with-kids.jpg`} alt="Naureen Stack standing with her two children" />
        </figure>
      </section>

      <section class="future-section" id="future" aria-labelledby="future-title">
        <div class="section-inner future-grid">
          <div>
            <p class="section-kicker">Campaign theme</p>
            <h2 id="future-title">Focused on the Future</h2>
          </div>
          <div class="future-copy">
            <p class="future-line">For our students. For our schools. For our community.</p>
            <p>
              School board service requires looking beyond the decision directly in front of us and considering where those decisions take our students, schools, and community in the years ahead.
            </p>
          </div>
        </div>
      </section>

      <section class="focus-section" id="focus" aria-labelledby="focus-title">
        <div class="focus-backdrop">
          <img src={`${base}images/naureen-heart-focus.jpg`} alt="" />
        </div>
        <div class="section-inner focus-layout">
          <div class="focus-intro">
            <p class="section-kicker">A steady approach</p>
            <h2 id="focus-title">FOCUS</h2>
            <p>
              A simple word for a serious responsibility: keeping every conversation, every question, and every decision connected to the future of Columbia CUSD 4.
            </p>
          </div>
          <div class="focus-acronym" aria-label="FOCUS acronym">
            {focusLetters.map((item) => (
              <article>
                <span>{item.letter}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="experience-section" id="experience" aria-labelledby="experience-title">
        <div class="section-inner experience-grid">
          <div class="experience-copy">
            <p class="section-kicker">Board service</p>
            <h2 id="experience-title">Four Years of Listening, Learning, Serving</h2>
            <p>
              Four years of school board service has given me a deeper understanding of both the opportunities and challenges facing our district.
            </p>
            <p>
              Good governance is not about having all of the answers. It is about doing the homework, asking good questions, listening to different perspectives, and making difficult decisions when necessary.
            </p>
            <p>
              I have also learned that serving on a school board is not always easy. The decisions we make affect people personally, and with that comes questions, concerns, criticism, and disagreement. <strong>I have learned to be OK with that.</strong> Good leadership is not about making the most popular decision or ensuring everyone agrees with you. It is about listening, asking questions, considering different perspectives, and being willing to make difficult decisions when you believe they are in the best interest of our students, schools, and community.
            </p>
            <p>
              I am proud to serve alongside a board that can disagree, challenge one another, and still work together respectfully with a shared commitment to doing what we believe is best for Columbia CUSD 4.
            </p>
          </div>
          <div class="experience-list">
            {experienceItems.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="progress-section" id="progress" aria-labelledby="progress-title">
        <div class="quote-band">
          <blockquote>
            “The way I see it, if you want the rainbow, you got to put up with the rain.”
          </blockquote>
          <cite>Dolly Parton</cite>
        </div>
        <div class="section-inner progress-story">
          <div>
            <p class="section-kicker">Progress and the work ahead</p>
            <h2 id="progress-title">Progress I’ve Been Proud to Support</h2>
          </div>
          <div class="progress-panel prose">
            <p>
              Progress does not mean we always agree. In fact, some of the most important decisions require thoughtful questions, different perspectives, and honest discussion.
            </p>
            <p>
              I am proud to serve on a board that can disagree respectfully, listen to one another, and ultimately work together with the best interests of our students, schools, and community at the center.
            </p>
            <p>
              I am especially proud of the work that has gone into providing our students with a new school. It is an investment that required planning, careful financial stewardship, and collaboration. Our students deserve an environment that supports their education while providing the highest level of safety we can reasonably provide, and being part of the work to make that possible is something I am incredibly proud of.
            </p>
            <p>
              I am also proud of the standard of excellence our schools continue to pursue. That credit belongs to many people, from our educators and staff to our administration, students, families, community, and board. Strong schools are built through the collective efforts of people who care deeply about the students they serve.
            </p>
            <p>
              There will always be more work to do, but I am proud of the progress we have made together, and I remain focused on where we go from here.
            </p>
          </div>
        </div>
        <p class="forward-statement">I am not focused only on where we’ve been. I’m focused on where we’re going.</p>
      </section>

      <section class="community-section" id="community" aria-labelledby="community-title">
        <div class="section-inner community-layout">
          <div class="community-copy">
            <p class="section-kicker">Showing up</p>
            <h2 id="community-title">Rooted in Our Community</h2>
            <p>
              My connection to Columbia schools did not begin when I joined the school board, and it does not end when a board meeting adjourns. Columbia has been my home for more than 20 years, and both of my children have attended our schools since pre-K.
            </p>
            <p>
              I have experienced this district not only as a board member, but as a parent sitting in the stands, attending activities, supporting teachers, and watching my own children grow up here.
            </p>
            <p>
              Outside of board service, I have tried to find meaningful ways to give back to the community I call home, from bringing back the Athlete of the Month program and hosting teacher appreciation events to attending sports and extracurricular activities, supporting local businesses, and through my work in real estate, helping families put down roots in the communities I serve.
            </p>
          </div>

          <div class="community-gallery" aria-label="Examples of Columbia school and community involvement">
            {communityGallery.map((image) => (
              <figure class="community-photo">
                <img src={`${base}${image.src}`} alt={image.alt} loading="lazy" />
                <figcaption>{image.caption}</figcaption>
              </figure>
            ))}
          </div>

          <p class="community-takeaway">
            For me, serving Columbia has never been limited to a seat at the board table. It is about showing up, supporting others, and investing in the community we are all working together to strengthen.
          </p>
        </div>
      </section>

      <section class="gratitude-section" id="gratitude" aria-labelledby="gratitude-title">
        <div class="section-inner gratitude-grid">
          <div>
            <p class="section-kicker">Thank you</p>
            <h2 id="gratitude-title">Grateful for the Opportunity to Serve</h2>
          </div>
          <div class="prose">
            <p>
              I am grateful for the trust this community placed in me four years ago. Serving our students, schools, and community has been an honor, and I do not take that responsibility lightly.
            </p>
            <p>
              These four years have included meaningful conversations, important decisions, challenges, lessons, and countless reminders of how special Columbia is. I am thankful for everyone who has shared ideas, concerns, encouragement, and perspective along the way.
            </p>
            <p>
              That gratitude strengthens my commitment to remain focused on the future: for our students, for our schools, and for our community.
            </p>
          </div>
        </div>
      </section>

      <section class="about-section" id="about" aria-labelledby="about-title">
        <div class="section-inner about-grid about-copy-only">
          <div class="prose">
            <p class="section-kicker">The person behind the campaign</p>
            <h2 id="about-title">A Little About Me</h2>
            <p>
              [Add Naureen’s connection to Columbia, her family and children, professional background, education, community involvement, and why she originally chose to serve on the school board.]
            </p>
            <p>
              This section should feel personal and grounded, not like a resume. It should help visitors understand the person behind the campaign and the community connection behind the service.
            </p>
          </div>
        </div>
      </section>

      <section class="why-section" id="why" aria-labelledby="why-title">
        <div class="section-inner why-grid">
          <div>
            <p class="section-kicker">Why I’m running again</p>
            <h2 id="why-title">Why Another Four Years?</h2>
          </div>
          <div class="prose">
            <p>
              Four years ago, I ran because I cared deeply about our schools and believed I could contribute something meaningful.
            </p>
            <p>
              Today, I am running with something I did not have then: four years of experience, perspective, lessons learned, difficult conversations, hard decisions, and an even greater appreciation for the responsibility that comes with serving.
            </p>
            <p>
              I believe there is more work to do, and I am asking the community for the opportunity to continue serving with focus, humility, and a steady commitment to our students, our schools, and our community.
            </p>
          </div>
        </div>
      </section>

      <section class="voices-section" id="voices" aria-labelledby="voices-title">
        <div class="section-inner voices-grid">
          <div>
            <p class="section-kicker">Community voices</p>
            <h2 id="voices-title">Shared Experiences and Perspectives</h2>
            <p>
              This section will give parents, educators, community members, and people who have worked alongside me a place to share their experiences in their own words.
            </p>
          </div>
          <div class="voice-list">
            {voices.map((voice) => (
              <figure>
                <blockquote>{voice.quote}</blockquote>
                <figcaption>{voice.name}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="questions-section" id="questions" aria-labelledby="questions-title">
        <div class="section-inner questions-grid">
          <div>
            <p class="section-kicker">Open communication</p>
            <h2 id="questions-title">Questions? Let’s Talk.</h2>
          </div>
          <div class="conversation-panel">
            <p>
              Respectful questions, conversations, and different perspectives are welcome, even when we do not agree. Open communication is part of how a community stays connected to its schools.
            </p>
            <a class="button primary" href="mailto:campaign@example.com">Email the campaign</a>
            <p class="small-note">Replace campaign@example.com with the official campaign email before launch.</p>
          </div>
        </div>
      </section>

      <section class="vote-section" id="vote" aria-labelledby="vote-title">
        <div class="section-inner vote-grid">
          <div>
            <p class="section-kicker">Election information</p>
            <h2 id="vote-title">Make a Plan to Vote</h2>
            <p>
              Election details can change, so voters should confirm registration, early voting, polling place, vote-by-mail, and Election Day information with the Monroe County Clerk or the Illinois State Board of Elections.
            </p>
            <div class="link-row">
              {voteLinks.map((link) => (
                <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
              ))}
            </div>
          </div>
          <div class="vote-details" aria-label="Election details">
            <div>
              <span>Election date</span>
              <strong>April 6, 2027</strong>
            </div>
            <div>
              <span>District</span>
              <strong>Columbia Community Unit School District 4</strong>
            </div>
            <div>
              <span>Local election office</span>
              <strong>Monroe County Clerk</strong>
            </div>
          </div>
        </div>
      </section>

      <section class="trust-section" aria-labelledby="trust-title">
        <div class="section-inner trust-grid">
          <div>
            <p class="section-kicker">Campaign information</p>
            <h2 id="trust-title">Before Public Launch</h2>
          </div>
          <ul>
            <li>This campaign is independent and is not sponsored by Columbia CUSD 4.</li>
            <li>Use official district logos, mascots, school property, and photos of students only with proper permission.</li>
            <li>[Add official campaign committee name, treasurer name if required, and final paid-for-by disclaimer.]</li>
          </ul>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>Re-elect Naureen Stack for Columbia CUSD 4 School Board</p>
      <p class="disclaimer">Paid for by [Campaign Committee Name].</p>
    </footer>
  </body>
</html>
