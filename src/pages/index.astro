---
import '../styles/global.css';

const priorities = [
  {
    title: 'Student Achievement',
    text: 'Keep board decisions focused on measurable learning, strong fundamentals, and the support every student needs to move forward.',
  },
  {
    title: 'Family Partnership',
    text: 'Families deserve clear communication, respectful listening, and a board that treats parents as partners in student success.',
  },
  {
    title: 'Educator Support',
    text: 'Strong schools require teachers and staff who are respected, supported, and equipped to serve students well.',
  },
  {
    title: 'Responsible Stewardship',
    text: 'Budgets should be transparent, practical, and tied to the classroom outcomes Columbia, IL families expect.',
  },
];

const involvement = [
  'Host a conversation',
  'Request a yard sign',
  'Help with voter outreach',
  'Share campaign updates',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Naureen Stack-Friedrick is running for re-election to the Columbia Community Unit School District 4 Board of Education in Columbia, IL. Learn why she is running and how to get involved."
    />
    <title>Re-elect Naureen Stack-Friedrick for Columbia School Board</title>
  </head>
  <body>
    <header class="site-header" aria-label="Campaign header">
      <a class="brand" href="#top" aria-label="Naureen campaign home">
        <img class="brand-mark" src={`${import.meta.env.BASE_URL}images/naureen-eagles-campaign-mark.svg`} alt="" />
        <span class="brand-name">Naureen Stack-Friedrick for Columbia School Board</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#why">Why</a>
        <a href="#priorities">Priorities</a>
        <a href="#involved">Get Involved</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero" aria-labelledby="hero-title" style={`--hero-image: url("${import.meta.env.BASE_URL}images/school-board-room-hero.png")`}>
        <div class="hero-image" aria-hidden="true"></div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
          <p class="eyebrow">Columbia, IL • CUSD 4 Board of Education</p>
          <h1 id="hero-title">Re-elect Naureen Stack-Friedrick.</h1>
          <p class="hero-copy">
            A steady, thoughtful voice on the current school board, running again to keep Columbia Community Unit School District 4 focused on students, families, educators, and responsible decisions.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#involved">Get Involved</a>
            <a class="button secondary" href="#why">Why I Am Running</a>
          </div>
        </div>
      </section>

      <section class="intro-section">
        <div class="section-inner intro-grid">
          <div>
            <p class="section-kicker">Re-election campaign</p>
            <h2>Experienced service. Clear priorities. Respect for the community.</h2>
          </div>
          <p>
            Naureen is a current school board member for Columbia Community Unit School District 4 and is running for re-election with a campaign built around facts, listening, and practical leadership. This campaign will stay focused on what matters most: strong schools, honest conversations, and decisions families can understand.
          </p>
        </div>
      </section>

      <section class="why-section" id="why" aria-labelledby="why-title">
        <div class="section-inner two-column">
          <div>
            <p class="section-kicker">Why I am running</p>
            <h2 id="why-title">I am running again because the work matters.</h2>
          </div>
          <div class="prose">
            <p>
              Serving on the school board is a responsibility I take seriously. Our schools shape the future of Columbia, IL, and every decision should be made with care, transparency, and respect for the people affected by it.
            </p>
            <p>
              I am running again to continue bringing a practical, prepared, and community-minded voice to the board. I believe students should remain at the center, parents should be heard, educators should be supported, and taxpayer dollars should be handled responsibly.
            </p>
          </div>
        </div>
      </section>

      <section class="priorities-section" id="priorities" aria-labelledby="priorities-title">
        <div class="section-inner">
          <div class="section-heading">
            <p class="section-kicker">Campaign priorities</p>
            <h2 id="priorities-title">A clean, educated campaign starts with substance.</h2>
          </div>
          <div class="priority-grid">
            {priorities.map((priority) => (
              <article class="priority-item">
                <h3>{priority.title}</h3>
                <p>{priority.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="involved-section" id="involved" aria-labelledby="involved-title">
        <div class="section-inner involved-grid">
          <div>
            <p class="section-kicker">Get involved</p>
            <h2 id="involved-title">Help keep experienced leadership on the board.</h2>
            <p>
              School board races are won through trust, relationships, and community conversations. Your support helps neighbors hear directly from Naureen and understand what is at stake for Columbia CUSD 4 schools.
            </p>
          </div>
          <div class="action-panel">
            <ul>
              {involvement.map((item) => <li>{item}</li>)}
            </ul>
            <a class="button primary full" href="mailto:campaign@example.com?subject=Naureen%20School%20Board%20Campaign">Contact the Campaign</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <p>Re-elect Naureen Stack-Friedrick for Columbia School Board</p>
      <p class="disclaimer">Campaign disclaimer to be added before public launch.</p>
    </footer>
  </body>
</html>
